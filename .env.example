# ==============================================================
# SAH WEB ADMIN - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================

# Port aplikasi saat dijalankan via Docker container
APP_PORT=8011

# Target API Backend yang digunakan oleh proxy Vite (/api):
#   ai   -> http://47.237.223.240:8010/ai (Server AI dengan data Teh Pucuk Harum & foto GCS)
#   dev  -> https://sah-dev.halotec.site (Server Dev Cloudflare)
#   atau URL lengkap kustom, contoh: http://localhost:8000
VITE_API_TARGET=ai

# Target Auth Service Backend (Laravel):
VITE_AUTH_TARGET=http://47.237.223.240:8010/be/api

# Mode Akses Tampilan (Bukan Super User / View Only):
#   true  -> View-Only (tanpa aksi CRUD: tombol Tambah SKU & Hapus disembunyikan)
#   false -> Mode normal
VITE_READ_ONLY=true

# (Opsional) Override Base URL langsung tanpa reverse proxy
VITE_BE_BASEURL=